# =============================================================================
# .env.staging.example - ambiente de STAGING (docker-compose.staging.yml)
# Copie para .env.staging:   cp .env.staging.example .env.staging
# No pipeline, estes valores vêm dos Secrets/Variables do environment "staging".
# =============================================================================

# Imagem publicada pelo pipeline no GitHub Container Registry
# (localmente pode deixar vazio: o compose builda a partir do Dockerfile)
API_IMAGE=ghcr.io/SEU_USUARIO/compliance-ambiental-api:staging
APP_VERSION=staging-local
APP_COMMIT_SHA=local
APP_BUILD_NUMBER=local
APP_DEPLOYED_AT=

# Portas publicadas no host (diferentes da produção para coexistirem)
API_PORT=8081
DB_PORT=14331

# Banco de dados isolado do ambiente de staging
MSSQL_SA_PASSWORD=Staging@Compliance2026!
DB_NAME=ComplianceAmbiental_Staging
MSSQL_MEMORY_LIMIT_MB=2048

# JWT (use um segredo diferente da produção)
JWT_ISSUER=ComplianceAmbiental.Api
JWT_AUDIENCE=ComplianceAmbiental.Client
JWT_SECRET_KEY=staging-jwt-secret-compliance-ambiental-logtech-2026-min-32-bytes!!
JWT_EXPIRES_MINUTES=120
