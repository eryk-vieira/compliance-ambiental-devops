# =============================================================================
# .env.production.example - ambiente de PRODUÇÃO (docker-compose.production.yml)
# Copie para .env.production:   cp .env.production.example .env.production
# NUNCA versione o .env.production real. No pipeline, estes valores vêm dos
# Secrets/Variables do environment "production" (com aprovação manual).
# =============================================================================

API_IMAGE=ghcr.io/SEU_USUARIO/compliance-ambiental-api:production
APP_VERSION=production-local
APP_COMMIT_SHA=local
APP_BUILD_NUMBER=local
APP_DEPLOYED_AT=

# Porta publicada no host (banco NÃO é exposto em produção)
API_PORT=8082

# Banco de dados de produção
MSSQL_SA_PASSWORD=TroqueEstaSenha@Prod2026!
DB_NAME=ComplianceAmbiental
MSSQL_MEMORY_LIMIT_MB=2048

# JWT (gere com: openssl rand -base64 48)
JWT_ISSUER=ComplianceAmbiental.Api
JWT_AUDIENCE=ComplianceAmbiental.Client
JWT_SECRET_KEY=TROQUE-por-um-segredo-forte-de-pelo-menos-32-bytes-gerado-com-openssl
JWT_EXPIRES_MINUTES=60
