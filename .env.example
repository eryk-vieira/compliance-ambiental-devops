# =============================================================================
# .env.example - ambiente LOCAL (docker-compose.yml)
# Copie para .env e ajuste:   cp .env.example .env
# =============================================================================

# --- Identificação ----------------------------------------------------------
APP_ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development
APP_VERSION=dev
APP_COMMIT_SHA=local
APP_BUILD_NUMBER=local

# --- Portas publicadas no host ---------------------------------------------
API_PORT=8080
DB_PORT=1433

# --- Banco de dados (SQL Server 2022) --------------------------------------
# A senha precisa atender a política do SQL Server (8+ chars, maiúscula,
# minúscula, número e símbolo).
MSSQL_SA_PASSWORD=Compliance@2026
DB_NAME=ComplianceAmbiental
MSSQL_MEMORY_LIMIT_MB=2048

# --- JWT -------------------------------------------------------------------
JWT_ISSUER=ComplianceAmbiental.Api
JWT_AUDIENCE=ComplianceAmbiental.Client
JWT_SECRET_KEY=chave-super-secreta-compliance-ambiental-logtech-2026-fiap-min-32-bytes
JWT_EXPIRES_MINUTES=120
